<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="malina"
        Arguments=""
        InstallLocation="C:\Program Files\Melting Core\Malina">
    </Installer>
    <PackageInformation
        PackageName="Malina"
        PackageDisplayName="Malina"
        PublisherName="CN=meltingcore"
        PublisherDisplayName="Melting Core"
        Version="0.1.3.0"
        PackageDescription="Easy backup and restore for Raspberry Pi">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.meltingcore.malina"
                Description="Easy backup and restore for Raspberry Pi"
                DisplayName="Malina"
                ExecutableName="malina"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Malina</DisplayName>
            <PublisherDisplayName>Melting Core</PublisherDisplayName>
            <Description>Easy backup and restore for Raspberry Pi</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="malina.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
